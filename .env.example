# .env.example — names only. No real values, ever.
#
# Copy this file to .env.local (or .env) and fill in real values for your
# own local setup only. .env* files are gitignored except this one — see
# docs/development.md for the full setup walkthrough and SECURITY.md for
# the secrets policy.
#
# Variables are grouped by which Phase 1 milestone (or later phase)
# introduces the provider that uses them. A variable being listed here does
# NOT mean it's required yet — see lib/env.ts for what's actually enforced
# today. Do not fill in a future-phase value just because the name exists
# here; only do so when that phase's milestone actually wires it up.

# ---------------------------------------------------------------------------
# Phase 1 (M1.2, current) — required now.
# Public: safe for the browser, inlined at build time by Next.js.
# ---------------------------------------------------------------------------

# One of: local | staging | production. Drives environment-specific behavior
# (e.g. the STAGING banner + noindex/nofollow requirement from ARCHITECTURE.md
# once M1.8 stands up a staging deployment). Validated at server startup by
# lib/env.ts via instrumentation.ts — the app refuses to start without it.
NEXT_PUBLIC_APP_ENV=local

# Optional, non-secret. Not part of the validated schema (has a safe default
# of "unset = telemetry enabled"). Set to 1 to keep Next.js's anonymous
# framework telemetry disabled on any machine/CI runner that builds this
# repo — see docs/development.md. This is unrelated to Sentry, audit logs,
# or any of Mason's own usage/cost tracking, which are never disabled by this.
# NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Phase 4 (M1.4) — Supabase. Not required until that milestone.
# ---------------------------------------------------------------------------

# Client-safe by Supabase's own design: this is just the project's REST
# endpoint, not a secret. A Supabase project already exists for HURKL
# ("Hurkl-production", org "Hurkl") — see ARCHITECTURE.md §2a for how it was
# inspected. Do not fill this in until M1.4 actually connects to it.
NEXT_PUBLIC_SUPABASE_URL=

# Client-safe by Supabase's own design: protected by Row-Level Security, not
# by keeping this secret. Do not confuse this with the service-role key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row-Level Security — use sparingly, only from
# trusted server-side code, per SECURITY.md's tenant-isolation requirements.
# Only needed if/when a server-side operation genuinely requires bypassing
# RLS; most Phase 2+ work should not need this at all.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Phase 6 — AI model provider (Anthropic Claude, behind AIModelProvider).
# Server-only. Not required until that phase.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Phase 6 (M1.6) — error tracking (Sentry). Server-only for now; a separate
# NEXT_PUBLIC_SENTRY_DSN would be introduced deliberately if/when
# client-side error reporting is added — do not reuse this one for that.
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Phase 7 (M1.7) — Trigger.dev background jobs (founder-approved
# BackgroundJobProvider; Inngest is the recorded fallback candidate).
# Server-only. Not required until that phase.
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=

# ---------------------------------------------------------------------------
# Phase 8 — voice pipeline. These are consumed by BOTH this Next.js app
# (for orchestration/config) and the separate, always-on Voice Gateway
# service that ARCHITECTURE.md §6 requires (Netlify cannot host the
# persistent WebSocket Twilio Media Streams needs). Server-only.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Phase 9 — email provider (Resend). Server-only. Not required until then.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# A note on A-1 Best Moving's existing Netlify environment variables
# ---------------------------------------------------------------------------
# The A-1 Best Moving Netlify site (a-1bestmoving) already has an
# ANTHROPIC_API_KEY and an ELEVENLABS_API_KEY configured, discovered during
# the Phase 1 infrastructure inspection. These are POSSIBLE existing
# credentials only — they were not created for HURKL/Mason, are not assumed
# to be authorized for this platform's use, and must not be copied into this
# repository or this app's environment without explicit founder
# verification that they're appropriate to reuse here. See
# docs/development.md for the full explanation. The A-1 Netlify site itself,
# and its environment variables, have not been touched or moved.
