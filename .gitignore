# Secrets & environment — never commit these.
# Patterns are scoped to actual secret-file conventions (env files, key/cert
# formats, common credential-dump filenames) rather than any file whose name
# merely contains a word like "secret" or "credentials" — a broad substring
# match would also ignore legitimate source files (e.g. secretsManager.ts,
# CredentialsForm.tsx), which is its own kind of accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
credentials.json
service-account*.json
serviceAccountKey.json
secrets.json
secrets.yml
secrets.yaml
*.secrets.json

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build output
.next/
out/
dist/
build/
.vercel/
.netlify/
.turbo/

# TypeScript (auto-regenerated; Next.js recreates next-env.d.ts on dev/build)
*.tsbuildinfo
next-env.d.ts

# Supabase local
.supabase/
supabase/.branches
supabase/.temp

# Testing
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Local data that should never be real customer data
*.sqlite
*.sqlite3
/tmp/
/scratch/

# Tenant seed data — real business contact info (phone, email, addresses)
# never gets committed, even for the A-1 pilot. Only the *.example.json
# templates are tracked; a real seed file is created locally per environment.
supabase/seed/*.json
!supabase/seed/*.example.json
