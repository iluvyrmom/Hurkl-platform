# A-1 Dump Estimator — environment variables
# Copy to .env.local and fill in. Never commit a real .env.local (see .gitignore
# and hurkl-platform's root SECURITY.md, whose secrets policy applies here too).
#
# This app runs fully in mock-provider mode with none of these set — the
# estimator, facility selection, and quote flow all work locally against
# in-memory/mock data so the product can be built and demoed before any paid
# provider is activated. See README.md "What's real vs. stubbed."

NEXT_PUBLIC_APP_ENV=local

# Absolute base URL of this deployment, used to build Stripe Checkout
# success/cancel URLs. Leave unset locally — derived from the request's
# Host header instead. Set explicitly in production (e.g. https://app.a1dump.example).
NEXT_PUBLIC_APP_URL=

# --- Supabase (facility DB, customers, estimates, jobs, auth, storage) ---
# Leave unset to run against the in-memory mock repositories with no auth.
# Once set, proxy.ts requires sign-in for every page except /sign-in, and
# every business_id-scoped table is enforced by Postgres RLS — see
# supabase/migrations/00000000000004_auth_and_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, NEVER exposed to the browser. Used
# exclusively by the Stripe webhook handler (lib/supabase/admin.ts), which
# has no business-member session for RLS to authorize against.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (customer payments) ---
# Leave unset: payment provider falls back to a mock that records a pending
# payment without contacting Stripe. Never activate a paid Stripe mode
# without explicit business-owner approval, and always start in Stripe test
# mode. STRIPE_WEBHOOK_SECRET is required for the webhook handler
# (app/api/stripe/webhook/route.ts) to accept any event — get it from the
# Stripe Dashboard's webhook endpoint configuration (or `stripe listen` in
# development), not the API keys page.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Photo AI analysis (junk-volume/weight estimation from photos) ---
# Provider-abstracted (see lib/providers/photo-analysis) so this can be
# swapped without touching the estimator engine. Leave unset to use the
# mock analyzer (returns a manual-entry placeholder).
OPENAI_API_KEY=
PHOTO_ANALYSIS_PROVIDER=mock

# --- Maps / routing (closest legal dump, travel time) ---
# Leave unset to use the mock maps provider (straight-line distance
# estimate only, no live traffic/routing).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- OCR (dump receipt verification) ---
# Leave unset to use the mock OCR provider (no text extraction).
OCR_PROVIDER=mock

# --- Notifications (quote delivery via SMS/email) ---
# Leave unset to use the mock notification provider (logs instead of sending).
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
